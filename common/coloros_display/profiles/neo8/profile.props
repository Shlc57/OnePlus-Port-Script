# 真我 Neo8 机型 Profile：识别跟随 OnePlus 15/Ace 6T 方式，由组合入口显式指定
# （COLOROS_DISPLAY_PROFILE=neo8）；device_codes 兜底填底包实测代号 RE6402L1，
# 市场名/Target 作自动匹配兜底。注意 Target `canoe` 与 Ace 6T 相同，自动匹配会
# 先命中 ace6t，因此 Neo8 入口必须显式锁定本 Profile。
# 面板表取自 Neo8 my_product/vendor/etc 的 P_1 官方表。底包缺
# multimedia_display_brightness_config.xml（lux/expressiveness 表），本 Profile 因此
# 不会生成 autoBrightness（模块 warn 后保留底包 displayconfig），也不设暗端锚点
# 重映射（跟随上游）。manifest 按 Neo8 my_product 实包整理。
display_name=Neo8
device_codes=RE6402L1
market_names=realme Neo8,真我Neo8
display_targets=canoe
panel_table=display_brightness_config_P_1.xml
# Neo8 底包 odm/build.prop 置 ro.vendor.oplus.sensor.high_pwm_rgb=true；禁用后传感器
# HAL 退回标准 lux 路径，代价与说明同 Ace 6T（见 ../README.md），待实机评定。
disable_high_pwm_rgb=1
