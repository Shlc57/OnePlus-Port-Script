(allow hal_mtkeysoter_default vendor_persist_drm_file (dir (ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_mtkeysoter_default vendor_persist_drm_file (file (ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads)))
(allow hal_mtkeysoter_default vendor_persist_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtkeysoter_default mnt_vendor_file_${API_VERSION} (dir (ioctl read write create getattr setattr lock relabelfrom rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_mtkeysoter_default vendor_persist_data_file (dir (getattr)))
