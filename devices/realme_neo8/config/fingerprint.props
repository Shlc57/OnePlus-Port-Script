# 真我 Neo8 超声波指纹目标设备硬件参数。
# features/fix_ultrasonic_fingerprint 只读取此显式配置，不从小米原包推断。
# 下列参考分辨率、传感器中心与图标尺寸已由 Neo8 原系统（ColorOS 16，RMX8899/RE6402L1）
# 真机采集回填，不再沿用 Ace 6T 估算值：
#   persist.vendor.fingerprint.sensor_type                = ultrasonic
#   persist.vendor.fingerprint.optical.sensorlocation     = 636::2058 → sensor.center.*
#   persist.vendor.fingerprint.optical.iconsize           = 195       → icon.width/height
#   dumpsys display supportedModes 原生档 = 1272x2772（另有 1080x2354 降档）→ reference.*
# 同次采集的相关事实（通用模块暂无对应键，仅留档）：settings fingerprint_pressed_icon_size=165、
# fingerprint_icon_info={"fpIconSize":165,"fpDownMarginBottomStatic":523}、fingerprint_icon_margin_bottom=606、
# optical.iconlocation=714、optical.circlenumber=10、optical.iconnumber=21、optical.sensorrotation=77.5、
# persist.vendor.fingerprint.fp_id=G_DOLPHIN_GUM_uff（Goodix 超声波方案）、vendor.fingerprint.aidl.support=1。
# sensor.area.* 仍无真机判据（原厂不暴露感应区尺寸），沿用同 SoC 估算值；DSU 上按压偏移时先校这两项。
ultrasonic.fp.reference.width=1272
ultrasonic.fp.reference.height=2772
ultrasonic.fp.sensor.center.x=636
ultrasonic.fp.sensor.center.y=2058
ultrasonic.fp.icon.width=195
ultrasonic.fp.icon.height=195
ultrasonic.fp.sensor.area.width=220
ultrasonic.fp.sensor.area.height=244
ultrasonic.fp.vendor=oplus
ultrasonic.fp.fingerdown.delay.ms=20
# 底包 sdm_display_resolution_extn.xml 中本机 SoC 对应的 Target 条目。
# Neo8（SM8845，第五代骁龙 8）对应 Target "canoe"；设置后只收集该 Target 下的
# PanelResolution，避免混入底包中其他平台（sun/anorak）的面板分辨率。
ultrasonic.fp.target=canoe
