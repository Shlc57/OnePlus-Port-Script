# Ace 6 机型 Profile：manifest 已按 DNA_ace6 底包 my_product 核实（FusionLight 只有
# fusionlight_Main_2_3.json，display RRO 只有 android_framework_res_overlay.display.product.24851.apk），
# 与 profiles/ace6/config/*.tsv 逐一对应。文件名里的 24851 是 Oplus display 工程 id（Ace 6T 底包
# 同名 24851，而其音频 prjname=24855，可见与 prjname 无必然绑定），非机型 prjname。优先按市场名或显示 Target 匹配。
display_name=Ace 6
device_codes=
market_names=OnePlus Ace 6
display_targets=sun
panel_table=display_brightness_config_P_7.xml
disable_high_pwm_rgb=1
# 暗端锚点跟随 Ace 6T（同款 P_7 表）；待 Ace 6 实机可见性数据后单独定值。
dark_anchor_value=0.0055
