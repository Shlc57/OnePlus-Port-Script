# ColorOS 钱包机型身份真值（features/fix_coloros_wallet 经 WALLET_IDENTITY_PROPERTIES_FILE 消费）。
# 一加 Ace 6：device/model 取自 DNA_ace6 底包 odm/etc/fingerprint.json（device=OP6113L1、
# product/model=PLQ110）。device/model 决定钱包 fdid 校验，且 odm.device 会改变运行时 Build.DEVICE，
# 必须与组合入口的 RUNTIME_DEVICE_CODE、XIAOAI_VOICEASSIST_DEVICE_CODE 保持一致；
# 机型 XML 由 common/fix_device_identity 按运行时代号改名。
brand=OnePlus
manufacturer=OnePlus
device=OP6113L1
model=PLQ110
name=PLQ110
marketname=一加 Ace 6
# cuptsm（ChinaUMT 安全元件标识，SE 厂商专有）；含竖线但无空格，原样写入。
# Ace 6 底包实测（DNA_ace6 odm/vendor build.prop）：ONEPLUS|ESE|01|27（不同于 Ace 6T 的 01|02）。
cuptsm=ONEPLUS|ESE|01|27
# 底包 ColorOS 版本标签（加载期 build.prop + 运行时 rc setprop 双写）。
# Ace 6 底包实测（DNA_ace6）：ro.build.version.oplusrom=V16.1.0、.display=16.1。
oplusrom=V16.1.0
oplusrom_display=16.1
# 区域标记，可选，缺省 CN。
regionmark=CN
region=CN
