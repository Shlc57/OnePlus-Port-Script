# 小爱唤醒机型参数（真我 Neo8 底包 project=25602，见 odm/etc/fingerprint.json 与
# odm/build.prop 的 ro.separate.soft=25602）。
# odm.prjname 非 0 时，模块额外把声学属性写入 import 链目标
# /odm/etc/<prjname>/build.gsi.prop——odm/etc/build.prop 头部 import 链
# 之后的属性段会被 HyperOS init 跳过（真机实测），D.N.A3 打包还会把
# 尾部属性重排回 import 之后；多载体当前仍需 root 真机复核属性可见性。
odm.prjname=25602
# Neo8 与 Ace 6T 同为 canoe（SM8845）声学栈，沿用其验证方案显式测试 DSP 与普通
# 录音并发；真机唤醒异常时回到默认不修改 PAL。
pal_concurrent_capture=true
