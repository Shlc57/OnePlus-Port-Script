# Ace 6 机型 Profile：底包设备代号与 my_product 取材暂未实测，优先按市场名或
# 显示 Target 匹配；manifest 暂按 Ace 6T 实包模板，取得 Ace 6 my_product 后核实。
display_name=Ace 6
device_codes=
market_names=OnePlus Ace 6
display_targets=sun
panel_table=display_brightness_config_P_7.xml
disable_high_pwm_rgb=1
# 暗端锚点跟随 Ace 6T（同款 P_7 表）；待 Ace 6 实机可见性数据后单独定值。
dark_anchor_value=0.0055
