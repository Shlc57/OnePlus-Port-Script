;; mtdservice and mtkeysoter exchange Binder handles directly.
(allow hal_mtdservice_default hal_mtkeysoter_default (binder (call transfer)))
(allow hal_mtkeysoter_default hal_mtdservice_default (binder (call transfer)))
(allow hal_mtdservice_default hal_mtkeysoter_default (fd (use)))
(allow hal_mtkeysoter_default hal_mtdservice_default (fd (use)))

;; Public clients and init-owned identity properties from the source contract.
(allow platform_app_${API_VERSION} vendor_cpuid_prop (file (read getattr map open)))
(allow system_app_${API_VERSION} vendor_payment_security_prop (file (read getattr map open)))
(allow system_app_${API_VERSION} vendor_cpuid_prop (file (read getattr map open)))
(allow shell_${API_VERSION} vendor_payment_security_prop (file (read getattr map open)))
(allow rild vendor_cpuid_prop (file (read getattr map open)))
(allow vendor_init_${API_VERSION} vendor_deviceid_prop (property_service (set)))
(allow system_server_${API_VERSION} hal_mtdservice_default (process (signal)))
