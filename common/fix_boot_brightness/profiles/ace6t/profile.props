# Ace 6T 机型 Profile：识别值来自底包实测（odm build.prop 与 DSU 运行时记录）。
# 仅安装启动默认亮度 Overlay；自动亮度改由 common/coloros_display 按
# my_product 的 P_7 官方表生成，因此移除小米曲线 Overlay。
display_name=Ace 6T
device_codes=nezha
market_names=OnePlus Ace 6T
display_targets=canoe
boot_overlay_name=Ace6TBootBrightnessOverlay.apk
remove_legacy_overlay=MiuiFrameworkResOverlay.apk
