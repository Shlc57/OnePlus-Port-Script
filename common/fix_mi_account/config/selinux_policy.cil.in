;; Xiaomi mtdservice policy owned by common/fix_mi_account.
;; common/selinux_merge expands API_VERSION and installs this fragment in the
;; one managed vendor-policy block.  These declarations and permissions are a
;; narrow transplant of the source mtdservice/mtkeysoter policy contract; the
;; source policy as a whole cannot be imported because its base_typeattr ABI
;; differs from the target vendor policy.

(typeattribute hal_mtdservice)
(typeattribute hal_mtdservice_server)
(typeattribute hal_mtdservice_client)

(type ta_data_file)
(roletype object_r ta_data_file)
(type hal_mtdservice_check)
(roletype object_r hal_mtdservice_check)
(type hal_mtdservice_check_exec)
(roletype object_r hal_mtdservice_check_exec)
(type hal_mtdservice_default)
(roletype object_r hal_mtdservice_default)
(type hal_mtdservice_default_exec)
(roletype object_r hal_mtdservice_default_exec)
(type hal_mtkeysoter_default)
(roletype object_r hal_mtkeysoter_default)
(type hal_mtkeysoter_default_exec)
(roletype object_r hal_mtkeysoter_default_exec)
(type vendor_payment_security_prop)
(roletype object_r vendor_payment_security_prop)
(type vendor_cpuid_prop)
(roletype object_r vendor_cpuid_prop)
(type vendor_deviceid_prop)
(roletype object_r vendor_deviceid_prop)
(type hal_mtdservice_service)
(roletype object_r hal_mtdservice_service)
(type hal_mtkeysoter_service)
(roletype object_r hal_mtkeysoter_service)

(typeattributeset domain (hal_mtdservice_check hal_mtdservice_default hal_mtkeysoter_default))
(typeattributeset halserverdomain (hal_mtdservice_default))
(typeattributeset halclientdomain (hal_mtdservice_check hal_mtdservice_default hal_mtkeysoter_default))
(typeattributeset file_type (ta_data_file hal_mtdservice_check_exec hal_mtdservice_default_exec hal_mtkeysoter_default_exec))
(typeattributeset data_file_type (ta_data_file))
(typeattributeset exec_type (hal_mtdservice_check_exec hal_mtdservice_default_exec hal_mtkeysoter_default_exec))
(typeattributeset vendor_file_type (hal_mtdservice_check_exec hal_mtdservice_default_exec hal_mtkeysoter_default_exec))
(typeattributeset property_type (vendor_payment_security_prop vendor_cpuid_prop vendor_deviceid_prop))
(typeattributeset vendor_property_type (vendor_payment_security_prop vendor_cpuid_prop vendor_deviceid_prop))
(typeattributeset vendor_public_property_type (vendor_payment_security_prop vendor_cpuid_prop vendor_deviceid_prop))
(typeattributeset service_manager_type (hal_mtdservice_service hal_mtkeysoter_service))
(typeattributeset protected_service (hal_mtdservice_service))
(typeattributeset hal_service_type (hal_mtdservice_service hal_mtkeysoter_service))

(typeattributeset hal_mtdservice (hal_mtdservice_default))
(typeattributeset hal_mtdservice_server (hal_mtdservice_default))
(typeattributeset hal_mtdservice_client (platform_app_${API_VERSION} system_app_${API_VERSION} system_server_${API_VERSION} hal_secure_element_default))
(typeattributeset hal_keymint_client (hal_mtdservice_default hal_mtkeysoter_default))
(typeattributeset hal_secure_element_client (hal_mtdservice_check hal_mtdservice_default hal_mtkeysoter_default))
(typeattributeset vendor_hal_soter_client (hal_mtdservice_default hal_mtkeysoter_default))

;; AIDL mtdservice registration and client contract.
(allow hal_mtdservice_client hal_mtdservice_server (binder (call transfer)))
(allow hal_mtdservice_server hal_mtdservice_client (binder (call transfer)))
(allow hal_mtdservice_client hal_mtdservice_server (fd (use)))
(allow hal_mtdservice_server hal_mtdservice_client (fd (use)))
(allow hal_mtdservice_server servicemanager_${API_VERSION} (binder (call transfer)))
(allow servicemanager_${API_VERSION} hal_mtdservice_server (binder (transfer)))
(allow hal_mtdservice_server servicemanager_${API_VERSION} (fd (use)))
(allow hal_mtdservice_client hal_mtdservice_service (service_manager (find)))
(allow hal_mtdservice_server hal_mtdservice_service (service_manager (add find)))

;; One-shot mtd_check domain.
(allow init_${API_VERSION} hal_mtdservice_check_exec (file (read getattr map execute open)))
(allow init_${API_VERSION} hal_mtdservice_check (process (transition)))
(allow hal_mtdservice_check hal_mtdservice_check_exec (file (read getattr map execute open entrypoint)))
(dontaudit init_${API_VERSION} hal_mtdservice_check (process (noatsecure)))
(allow init_${API_VERSION} hal_mtdservice_check (process (siginh rlimitinh)))
(typetransition init_${API_VERSION} hal_mtdservice_check_exec process hal_mtdservice_check)
(allow hal_mtdservice_check servicemanager_${API_VERSION} (binder (call transfer)))
(allow servicemanager_${API_VERSION} hal_mtdservice_check (binder (call transfer)))
(allow hal_mtdservice_check vendor_system_prop (file (read getattr map open)))
(allow hal_mtdservice_check property_socket_${API_VERSION} (sock_file (write)))
(allow hal_mtdservice_check init_${API_VERSION} (unix_stream_socket (connectto)))
(allow hal_mtdservice_check vendor_payment_security_prop (property_service (set)))
(allow hal_mtdservice_check vendor_payment_security_prop (file (read getattr map open)))
(allow hal_mtdservice_check vendor_persist_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtdservice_check vendor_persist_drm_file (dir (ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_mtdservice_check vendor_persist_drm_file (file (ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads)))
(allow hal_mtdservice_check mnt_vendor_file_${API_VERSION} (dir (ioctl read write create getattr setattr lock relabelfrom rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_mtdservice_check file_contexts_file_${API_VERSION} (file (ioctl read getattr lock map open watch watch_reads)))
(allow hal_mtdservice_check self (qipcrtr_socket (create)))
(allow hal_mtdservice_check firmware_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtdservice_check firmware_file (file (ioctl read getattr lock map open watch watch_reads)))
(allow hal_mtdservice_check tee_device_${API_VERSION} (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_mtdservice_check ta_data_file (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow hal_mtdservice_check ta_data_file (dir (ioctl read write getattr lock open watch watch_reads add_name remove_name search)))
(allow hal_mtdservice_check vendor_dmabuf_qseecom_heap_device (chr_file (ioctl read open)))
(allow hal_mtdservice_check vendor_dmabuf_qseecom_ta_heap_device (chr_file (ioctl read open)))

;; Long-running mtdservice domain.
(allow init_${API_VERSION} hal_mtdservice_default_exec (file (read getattr map execute open)))
(allow init_${API_VERSION} hal_mtdservice_default (process (transition)))
(allow hal_mtdservice_default hal_mtdservice_default_exec (file (read getattr map execute open entrypoint)))
(dontaudit init_${API_VERSION} hal_mtdservice_default (process (noatsecure)))
(allow init_${API_VERSION} hal_mtdservice_default (process (siginh rlimitinh)))
(typetransition init_${API_VERSION} hal_mtdservice_default_exec process hal_mtdservice_default)
(allow hal_mtdservice_default servicemanager_${API_VERSION} (binder (call transfer)))
(allow servicemanager_${API_VERSION} hal_mtdservice_default (binder (call transfer)))
(allow hal_mtdservice_default firmware_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtdservice_default firmware_file (file (ioctl read getattr lock map open watch watch_reads)))
(allow hal_mtdservice_default init_${API_VERSION} (unix_stream_socket (connectto)))
(allow hal_mtdservice_default ion_device_${API_VERSION} (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_mtdservice_default vendor_persist_drm_file (dir (ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_mtdservice_default vendor_persist_drm_file (file (ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads)))
(allow hal_mtdservice_default vendor_persist_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtdservice_default mnt_vendor_file_${API_VERSION} (dir (ioctl read write create getattr setattr lock relabelfrom rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow hal_mtdservice_default proc_${API_VERSION} (file (ioctl read getattr lock map open watch watch_reads)))
(allow hal_mtdservice_default tee_device_${API_VERSION} (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_mtdservice_default system_data_file_${API_VERSION} (dir (getattr)))
(allow hal_mtdservice_default property_socket_${API_VERSION} (sock_file (write)))
(allow hal_mtdservice_default vendor_payment_security_prop (property_service (set)))
(allow hal_mtdservice_default vendor_payment_security_prop (file (read getattr map open)))
(allow hal_mtdservice_default vendor_system_prop (file (read getattr map open)))
(allow hal_mtdservice_default vendor_cpuid_prop (file (read getattr map open)))
(allow hal_mtdservice_default vendor_hal_soter_qti (binder (call transfer)))
(allow vendor_hal_soter_qti hal_mtdservice_default (binder (transfer)))
(allow hal_mtdservice_default vendor_hal_soter_qti (fd (use)))
(allow hal_mtdservice_default ta_data_file (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow hal_mtdservice_default ta_data_file (dir (ioctl read write getattr lock open watch watch_reads add_name remove_name search)))
(allow hal_mtdservice_default sysfs_${API_VERSION} (dir (read open)))
(allow hal_mtdservice_default sysfs_${API_VERSION} (file (read write open)))
(allow hal_mtdservice_default vendor_qce_device (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_mtdservice_default vendor_sg_device (chr_file (ioctl read write open)))
(allow hal_mtdservice_default vendor_persist_data_file (dir (getattr)))
(allow hal_mtdservice_default vendor_smcinvoke_device_${API_VERSION} (chr_file (ioctl read write open)))
(allow hal_mtdservice_default block_device_${API_VERSION} (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtdservice_default nfc_device_${API_VERSION} (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_mtdservice_default self (qipcrtr_socket (read write create getattr setopt)))
(allow hal_mtdservice_default vendor_ese_gpio_device (chr_file (ioctl read write open)))
(allow hal_mtdservice_default vendor_tee_listener_prop (file (read getattr map open)))
(allow hal_mtdservice_default vendor_deviceid_prop (file (read getattr map open)))
(allow hal_mtdservice_default hal_mtkeysoter_service (service_manager (find)))
(allow hal_mtdservice_default vendor_dmabuf_qseecom_heap_device (chr_file (ioctl read open)))
(allow hal_mtdservice_default vendor_dmabuf_qseecom_ta_heap_device (chr_file (ioctl read open)))

