(allow servicemanager_${API_VERSION} hal_mtkeysoter_default (binder (call transfer)))
(allow hal_mtkeysoter_default servicemanager_${API_VERSION} (fd (use)))
(allow hal_mtkeysoter_default hal_mtkeysoter_service (service_manager (add find)))
(allow hal_mtkeysoter_default firmware_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_mtkeysoter_default firmware_file (file (ioctl read getattr lock map open watch watch_reads)))
